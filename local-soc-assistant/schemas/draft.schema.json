{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "event_id",
        "field",
        "value"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "technique_id": {
          "pattern": "^T[0-9]{4}([.][0-9]{3})?$",
          "title": "Technique Id",
          "type": "string"
        },
        "rationale": {
          "maxLength": 300,
          "title": "Rationale",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 4,
          "title": "Evidence",
          "type": "array"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Source Ids",
          "type": "array"
        },
        "verdict": {
          "default": "unchecked",
          "enum": [
            "unchecked",
            "supported",
            "rejected",
            "analyst_required"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "technique_id",
        "rationale",
        "evidence"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Recommendation": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "review_process",
            "collect_logs",
            "check_account",
            "confirm_authorization"
          ],
          "title": "Action",
          "type": "string"
        },
        "condition": {
          "maxLength": 400,
          "title": "Condition",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 4,
          "title": "Evidence",
          "type": "array"
        },
        "status": {
          "default": "unchecked",
          "enum": [
            "unchecked",
            "supported",
            "analyst_required",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "technique_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Technique Ids",
          "type": "array"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "action",
        "condition"
      ],
      "title": "Recommendation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "facts": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 4,
      "title": "Facts",
      "type": "array"
    },
    "hypotheses": {
      "items": {
        "type": "string"
      },
      "maxItems": 3,
      "title": "Hypotheses",
      "type": "array"
    },
    "techniques": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "maxItems": 3,
      "title": "Techniques",
      "type": "array"
    },
    "recommendations": {
      "items": {
        "$ref": "#/$defs/Recommendation"
      },
      "maxItems": 2,
      "title": "Recommendations",
      "type": "array"
    },
    "missing": {
      "items": {
        "type": "string"
      },
      "maxItems": 4,
      "title": "Missing",
      "type": "array"
    },
    "abstentions": {
      "items": {
        "type": "string"
      },
      "maxItems": 4,
      "title": "Abstentions",
      "type": "array"
    }
  },
  "title": "Draft",
  "type": "object",
  "$id": "urn:local-soc-assistant:draft:1.1"
}