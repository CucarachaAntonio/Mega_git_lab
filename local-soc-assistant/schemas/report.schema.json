{
  "$defs": {
    "Check": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "title": "Target",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_checked"
          ],
          "title": "Status",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "needed": {
          "items": {
            "type": "string"
          },
          "title": "Needed",
          "type": "array"
        }
      },
      "required": [
        "target",
        "code",
        "status",
        "detail"
      ],
      "title": "Check",
      "type": "object"
    },
    "Chunk": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "source_sha256": {
          "title": "Source Sha256",
          "type": "string"
        },
        "technique_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Technique Id"
        },
        "score": {
          "default": 0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "chunk_id",
        "document_id",
        "text",
        "title",
        "source",
        "version",
        "source_sha256"
      ],
      "title": "Chunk",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "event_id",
        "field",
        "value"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "technique_id": {
          "pattern": "^T[0-9]{4}([.][0-9]{3})?$",
          "title": "Technique Id",
          "type": "string"
        },
        "rationale": {
          "maxLength": 300,
          "title": "Rationale",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 4,
          "title": "Evidence",
          "type": "array"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Source Ids",
          "type": "array"
        },
        "verdict": {
          "default": "unchecked",
          "enum": [
            "unchecked",
            "supported",
            "rejected",
            "analyst_required"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "technique_id",
        "rationale",
        "evidence"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Link": {
      "additionalProperties": false,
      "properties": {
        "from_event": {
          "title": "From Event",
          "type": "string"
        },
        "to_event": {
          "title": "To Event",
          "type": "string"
        },
        "rule": {
          "title": "Rule",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "delta_seconds": {
          "title": "Delta Seconds",
          "type": "number"
        }
      },
      "required": [
        "from_event",
        "to_event",
        "rule",
        "reasons",
        "delta_seconds"
      ],
      "title": "Link",
      "type": "object"
    },
    "Recommendation": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "review_process",
            "collect_logs",
            "check_account",
            "confirm_authorization"
          ],
          "title": "Action",
          "type": "string"
        },
        "condition": {
          "maxLength": 400,
          "title": "Condition",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 4,
          "title": "Evidence",
          "type": "array"
        },
        "status": {
          "default": "unchecked",
          "enum": [
            "unchecked",
            "supported",
            "analyst_required",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "technique_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Technique Ids",
          "type": "array"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "action",
        "condition"
      ],
      "title": "Recommendation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "mode": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "title": "Mode",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "abstained",
        "technical_error"
      ],
      "title": "Status",
      "type": "string"
    },
    "versions": {
      "additionalProperties": true,
      "title": "Versions",
      "type": "object"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Facts",
      "type": "array"
    },
    "hypotheses": {
      "items": {
        "type": "string"
      },
      "title": "Hypotheses",
      "type": "array"
    },
    "techniques": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Techniques",
      "type": "array"
    },
    "recommendations": {
      "items": {
        "$ref": "#/$defs/Recommendation"
      },
      "title": "Recommendations",
      "type": "array"
    },
    "priority": {
      "default": "unknown",
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ],
      "title": "Priority",
      "type": "string"
    },
    "priority_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Priority Reasons",
      "type": "array"
    },
    "timeline": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Timeline",
      "type": "array"
    },
    "links": {
      "items": {
        "$ref": "#/$defs/Link"
      },
      "title": "Links",
      "type": "array"
    },
    "missing": {
      "items": {
        "type": "string"
      },
      "title": "Missing",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/Check"
      },
      "title": "Checks",
      "type": "array"
    },
    "refusals": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Refusals",
      "type": "array"
    },
    "errors": {
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Errors",
      "type": "array"
    },
    "retrieval": {
      "additionalProperties": true,
      "title": "Retrieval",
      "type": "object"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Chunk"
      },
      "title": "Sources",
      "type": "array"
    },
    "durations": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Durations",
      "type": "object"
    },
    "environment": {
      "additionalProperties": true,
      "title": "Environment",
      "type": "object"
    },
    "attempts": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Attempts",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "case_id",
    "mode",
    "status",
    "versions"
  ],
  "title": "Report",
  "type": "object",
  "$id": "urn:local-soc-assistant:report:1.1"
}